DROP TABLE COURSE;
DROP TABLE FACULTY;
DROP TABLE STUDENT;
DROP TABLE DEPARTMENT;

CREATE TABLE DEPARTMENT(
DEPT_ID VARCHAR2(10),
DEPT_NAME VARCHAR2(20)NOT NULL,
HOD_NAME VARCHAR2(20),
OFFICE_LOCATION VARCHAR2(40),
CONTACT_NO VARCHAR2(15),

CONSTRAINT pk_DEP PRIMARY KEY (DEPT_ID),
CONSTRAINT  UD_DEP UNIQUE (DEPT_NAME));

CREATE TABLE STUDENT(
STUDENT_ID VARCHAR2(10) PRIMARY KEY,
STUDENT_NAME VARCHAR2(20),
DOB DATE,
GENDER CHAR(1) CHECK(GENDER IN ('F','M')),
MOB_NO NUMERIC,
EMAIL_ID VARCHAR2(40) UNIQUE,
DEPT_ID VARCHAR2(10),
ADMISSION_DATE DATE DEFAULT SYSDATE,
CGPA NUMERIC (4,2)
);

CREATE TABLE FACULTY(
FACULTY_ID NUMBER(5) PRIMARY KEY,
FACULTY_NAME VARCHAR2(60) NOT NULL,
QUALIFICATION VARCHAR2(50) NOT NULL,
DESIGNATION VARCHAR2(50) NOT NULL,
JOINING_DATE DATE DEFAULT SYSDATE,
SALARY NUMBER(10,2) CHECK(SALARY > 0),
EMAIL_ID VARCHAR2(80) UNIQUE,
DEPT_ID NUMBER(5)
);

CREATE TABLE COURSE(
COURSE_ID VARCHAR2(5) PRIMARY KEY,
COURSE_NAME VARCHAR2(40),
CREDITS NUMBER CHECK(CREDITS BETWEEN 1 AND 6),
SEMESTER NUMERIC(8),
DEPT_ID VARCHAR2(10),
FACULTY_ID NUMBER(5)
);

