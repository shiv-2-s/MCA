CREATE TABLE SUPPLIER(
    SUPPLIER_ID VARCHAR2(10) PRIMARY KEY,
    SUPPLIER_NAME VARCHAR2(50) NOT NULL,
    CONTACT_PERSON VARCHAR2(50),
    MOBILE_NUMBER VARCHAR2(15),
    EMAIL_ID VARCHAR2(50) UNIQUE,
    ADDRESS VARCHAR2(100),
    CITY VARCHAR2(30)
);



CREATE TABLE CATEGORY(
    CATEGORY_ID VARCHAR2(10) PRIMARY KEY,
    CATEGORY_NAME VARCHAR2(50) UNIQUE NOT NULL,
    DESCRIPTION VARCHAR2(100)
);



CREATE TABLE PRODUCT(
    PRODUCT_ID VARCHAR2(10) PRIMARY KEY,
    PRODUCT_NAME VARCHAR2(50) NOT NULL,
    CATEGORY_ID VARCHAR2(10) REFERENCES CATEGORY(CATEGORY_ID),
    SUPPLIER_ID VARCHAR2(10) REFERENCES SUPPLIER(SUPPLIER_ID),
    UNIT_PRICE NUMBER CHECK (UNIT_PRICE > 0),
    REORDER_LEVEL NUMBER CHECK (REORDER_LEVEL >= 0),
    QUANTITY_AVAILABLE NUMBER CHECK (QUANTITY_AVAILABLE >= 0)
);



CREATE TABLE PURCHASE(
    PURCHASE_ID VARCHAR2(10) PRIMARY KEY,
    SUPPLIER_ID VARCHAR2(10) REFERENCES SUPPLIER(SUPPLIER_ID),
    PURCHASE_DATE DATE DEFAULT SYSDATE,
    TOTAL_AMOUNT NUMBER CHECK (TOTAL_AMOUNT >= 0)
);



CREATE TABLE PURCHASE_ITEM(
    PURCHASE_ITEM_ID VARCHAR2(10) PRIMARY KEY,
    PURCHASE_ID VARCHAR2(10) REFERENCES PURCHASE(PURCHASE_ID),
    PRODUCT_ID VARCHAR2(10) REFERENCES PRODUCT(PRODUCT_ID),
    QUANTITY_PURCHASED NUMBER CHECK (QUANTITY_PURCHASED > 0),
    PURCHASE_PRICE NUMBER CHECK (PURCHASE_PRICE > 0),

    UNIQUE (PURCHASE_ID, PRODUCT_ID)
);


CREATE TABLE CUSTOMER(
    CUSTOMER_ID VARCHAR2(10) PRIMARY KEY,
    CUSTOMER_NAME VARCHAR2(50) NOT NULL,
    MOBILE_NUMBER VARCHAR2(15),
    EMAIL_ID VARCHAR2(50) UNIQUE,
    ADDRESS VARCHAR2(100),
    CITY VARCHAR2(30)
);


CREATE TABLE SALES(
    SALES_ID VARCHAR2(10) PRIMARY KEY,
    CUSTOMER_ID VARCHAR2(10) REFERENCES CUSTOMER(CUSTOMER_ID),
    SALES_DATE DATE DEFAULT SYSDATE,
    TOTAL_AMOUNT NUMBER CHECK (TOTAL_AMOUNT >= 0),
    PAYMENT_STATUS VARCHAR2(10)
        CHECK (PAYMENT_STATUS IN ('PAID', 'UNPAID', 'PARTIAL'))
);



CREATE TABLE SALES_ITEM(
    SALES_ITEM_ID VARCHAR2(10) PRIMARY KEY,
    SALES_ID VARCHAR2(10) REFERENCES SALES(SALES_ID),
    PRODUCT_ID VARCHAR2(10) REFERENCES PRODUCT(PRODUCT_ID),
    QUANTITY_SOLD NUMBER CHECK (QUANTITY_SOLD > 0),
    SELLING_PRICE NUMBER CHECK (SELLING_PRICE > 0),

    UNIQUE (SALES_ID, PRODUCT_ID)
);


CREATE TABLE PAYMENT(
    PAYMENT_ID VARCHAR2(10) PRIMARY KEY,
    SALES_ID VARCHAR2(10) REFERENCES SALES(SALES_ID),
    PAYMENT_DATE DATE DEFAULT SYSDATE,
    AMOUNT_PAID NUMBER CHECK (AMOUNT_PAID > 0),
    PAYMENT_MODE VARCHAR2(15)
        CHECK (PAYMENT_MODE IN ('CASH', 'CARD', 'UPI', 'BANK_TRANSFER'))
);


