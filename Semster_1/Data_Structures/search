#include <stdio.h>

int main() {
    int n, key, found = 0;

    printf("Enter the number of elements: ");
    scanf("%d", &n);

    int arr[n];

    printf("Enter the array elements: ");
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter the element to search: ");
    scanf("%d", &key);

    printf("Element found at positions: ");
    for (int i = 0; i < n; i++) {
        if (arr[i] == key) {
            printf("%d ", i);   // Prints 0-based index
            found = 1;
        }
    }

    if (!found) {
        printf("Element not found.");
    }

    return 0;
}
